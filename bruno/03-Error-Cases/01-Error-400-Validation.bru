meta {
  name: 01 - Error 400 Validacion Datos Invalidos
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "",
    "lastName": "Test",
    "email": "correo-invalido",
    "password": "123"
  }
}

tests {
  test("Status 400 Bad Request con mapa de errores", function() {
    expect(res.status).to.equal(400);
    expect(res.body.errors).to.be.an("object");
  });
}