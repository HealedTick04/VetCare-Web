meta {
  name: 02 - Login Client
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "laura.cliente@vetcare.com",
    "password": "VetCare2026!"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("clientToken", res.body.token);
  }
}

tests {
  test("Status 200 y token de cliente recibido", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.role).to.equal("CLIENT");
  });
}