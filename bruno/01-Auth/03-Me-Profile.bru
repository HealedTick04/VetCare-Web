meta {
  name: 03 - Obtener Perfil Actual (JWT)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Status 200 con perfil autenticado", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal("admin@vetcare.com");
  });
}