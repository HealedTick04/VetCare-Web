meta {
  name: 01 - Listar Mascotas Paginado
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/pets?page=0&size=5
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 5
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Status 200 y paginación activa", function() {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.be.an("array");
  });
}